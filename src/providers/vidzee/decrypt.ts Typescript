// src/providers/vidzee/decrypt.ts

/**
 * فك تشفير بيانات vidzee
 * @param data - البيانات المشفرة
 * @returns البيانات المفككة
 */
export function decryptVidzee(data: string | Buffer): string {
    try {
        // تحويل البيانات إلى string
        let encodedData = typeof data === 'string' ? data : data.toString();
        
        // محاولة فك التشفير Base64
        try {
            const decoded = Buffer.from(encodedData, 'base64').toString('utf-8');
            return decoded;
        } catch (e) {
            // إذا لم يكن Base64، نعيد البيانات كما هي
            return encodedData;
        }
    } catch (error) {
        console.error('Decryption error:', error);
        return typeof data === 'string' ? data : data.toString();
    }
}

/**
 * فك تشفير الروابط
 * @param url - الرابط المشفر
 * @returns الرابط المفكك
 */
export function decryptUrl(url: string): string {
    try {
        // فك تشفير reverse
        if (url.includes('reverse:')) {
            return url.replace('reverse:', '').split('').reverse().join('');
        }
        
        // فك تشفير base64
        if (url.includes('base64:')) {
            const base64Part = url.replace('base64:', '');
            return Buffer.from(base64Part, 'base64').toString('utf-8');
        }
        
        return url;
    } catch (error) {
        console.error('URL decryption error:', error);
        return url;
    }
}

/**
 * دالة عامة لفك التشفير
 */
export function decrypt(data: string | Buffer): string {
    return decryptVidzee(data);
}

export default {
    decryptVidzee,
    decryptUrl,
    decrypt
};
